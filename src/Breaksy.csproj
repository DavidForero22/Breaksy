<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms solo se usa para el icono de la bandeja del sistema (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Breaksy</RootNamespace>
    <AssemblyName>Breaksy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Breaksy.Program</StartupObject>
    <Version>0.1.2</Version>
    <ApplicationIcon>..\assets\icon\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evitar ambigüedades entre tipos de WPF y WinForms (Application, MessageBox, Color...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\assets\**\*.*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Guía para el usuario: se distribuye junto al ejecutable (instalador y portable) -->
    <Content Include="..\docs\Guía de Personalización Breaksy.pdf" Link="Guía de Personalización Breaksy.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>
</Project>
