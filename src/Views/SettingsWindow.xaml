<Window x:Class="Breaksy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración - Breaksy"
        Height="200"
        Width="300"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#252526"
        Foreground="White">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Opciones Generales"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,0,15"
                    Foreground="#4FC3F7"/>
            <CheckBox Content="Silenciar voces y sonidos"
                      IsChecked="{Binding IsMuted}"
                      Foreground="White"
                    FontSize="14"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>