<Window x:Class="Breaksy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Breaksy.Views"
        Title="{local:Loc settings.title}"
        Width="920"
        Height="560"
        MinWidth="600"
        MinHeight="400"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">

    <!-- Barra de título propia: se puede arrastrar desde la franja superior y redimensionar por los bordes -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <TabControl Style="{StaticResource SidebarTabControl}">

            <!-- General -->
            <TabItem Header="{local:Loc tab.general}">
                <StackPanel>
                    <TextBlock Text="{local:Loc tab.general}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{local:Loc general.subtitle}"
                               Style="{StaticResource PageSubtitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{local:Loc general.autostart}" Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="{local:Loc general.autostart_desc}"
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding StartWithWindows}"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <TextBlock Text="{local:Loc general.language}" Style="{StaticResource OptionTitle}"/>
                    <TextBlock Text="{local:Loc general.language_desc}"
                               Style="{StaticResource OptionDescription}"/>
                    <ListBox Style="{StaticResource SegmentedControl}"
                             ItemsSource="{Binding Languages}"
                             SelectedItem="{Binding SelectedLanguage}"
                             DisplayMemberPath="Name"
                             Margin="0,10,0,0"/>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <TextBlock Text="{local:Loc general.version}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Style="{StaticResource OptionTitle}">
                        <Run Text="Breaksy"/>
                        <Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="{local:Loc general.history}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenReleaseHistoryCommand}"
                            ToolTip="{local:Loc general.history_tip}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"/>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <TextBlock Text="{local:Loc general.updates}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding Updates.Status}"
                               Style="{StaticResource OptionDescription}"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{local:Loc general.check_updates}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CheckUpdatesCommand}"
                                IsEnabled="{Binding Updates.IsInstalled}"
                                Margin="0,0,8,0"/>
                        <Button Content="{local:Loc general.install_update}"
                                Command="{Binding InstallUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Updates.IsUpdateAvailable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Updates.IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Aplicación -->
            <TabItem Header="{local:Loc tab.app}">
                <StackPanel>
                    <TextBlock Text="{local:Loc tab.app}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{local:Loc app.subtitle}"
                               Style="{StaticResource PageSubtitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{local:Loc app.voices}" Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="{local:Loc app.voices_desc}"
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding PlayVoices}"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{local:Loc app.sounds}" Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="{local:Loc app.sounds_desc}"
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding PlaySounds}"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{local:Loc app.show_state}" Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="{local:Loc app.show_state_desc}"
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding ShowState}"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{local:Loc app.show_timer}" Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="{local:Loc app.show_timer_desc}"
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding ShowTimer}"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <TextBlock Text="{local:Loc app.level}" Style="{StaticResource OptionTitle}"/>
                    <ListBox Style="{StaticResource SegmentedControl}"
                             ItemsSource="{Binding InterruptionLevels}"
                             SelectedItem="{Binding SelectedInterruptionLevel}"
                             DisplayMemberPath="Name"
                             Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding SelectedInterruptionLevel.Description}"
                               Style="{StaticResource OptionDescription}"
                               Margin="0,8,0,0"/>

                    <!-- Aviso si Windows no permitió registrar el hook de teclado -->
                    <Border Background="#33F23F43"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,12,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardBlockUnavailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{local:Loc app.keyboard_warning}"
                                   Style="{StaticResource OptionDescription}"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0"/>
                    </Border>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <!-- Duraciones -->
                    <StackPanel DataContext="{Binding TestMenu}">
                        <TextBlock Text="{local:Loc app.durations}" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:Loc app.work}" Style="{StaticResource OptionDescription}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBox}" HorizontalAlignment="Left"
                                         Text="{Binding AwakenMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{local:Loc app.warnings}" Style="{StaticResource OptionDescription}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBox}" HorizontalAlignment="Left"
                                         Text="{Binding WarningMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{local:Loc app.rest}" Style="{StaticResource OptionDescription}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBox}" HorizontalAlignment="Left"
                                         Text="{Binding SleepSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Personalización -->
            <TabItem Header="{local:Loc tab.custom}">
                <StackPanel>
                    <TextBlock Text="{local:Loc tab.custom}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{local:Loc custom.subtitle}"
                               Style="{StaticResource PageSubtitle}"/>

                    <!-- Editor de personaje (interfaz y lógica en CharacterEditorView) -->
                    <TextBlock Text="{local:Loc custom.editor}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{local:Loc custom.editor_desc}"
                               Style="{StaticResource OptionDescription}"
                               Margin="0,3,0,0"/>
                    <local:CharacterEditorView DataContext="{Binding CharacterEditor}"/>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <!-- Editor manual -->
                    <TextBlock Text="{local:Loc custom.manual}" Style="{StaticResource SectionLabel}"/>

                    <TextBlock Text="{local:Loc custom.guide}" Style="{StaticResource OptionTitle}"/>
                    <TextBlock Text="{local:Loc custom.guide_desc}"
                               Style="{StaticResource OptionDescription}"
                               Margin="0,3,0,12"/>
                    <Button Content="{local:Loc custom.open_guide}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenCustomizationGuideCommand}"
                            HorizontalAlignment="Left"/>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <TextBlock Text="{local:Loc custom.folder}" Style="{StaticResource OptionTitle}"/>
                    <TextBlock Text="{local:Loc custom.folder_desc}"
                               Style="{StaticResource OptionDescription}"
                               Margin="0,3,0,6"/>
                    <TextBlock Text="{Binding CustomizationFolder, Mode=OneWay}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               Foreground="{StaticResource SubtleTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <Button Content="{local:Loc custom.open_folder}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenCustomizationFolderCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <!-- Desarrollador -->
            <TabItem Header="{local:Loc tab.dev}">
                <StackPanel>
                    <TextBlock Text="{local:Loc tab.dev}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{local:Loc dev.subtitle}"
                               Style="{StaticResource PageSubtitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{local:Loc dev.console}" Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="{local:Loc dev.console_desc}"
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding IsDebugConsoleEnabled}"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <!-- Menú de pruebas -->
                    <StackPanel DataContext="{Binding TestMenu}">
                        <TextBlock Text="{local:Loc dev.force_state}" Style="{StaticResource SectionLabel}"/>
                        <ListBox Style="{StaticResource SegmentedControl}"
                                 ItemsSource="{Binding AvailableStates}"
                                 SelectedItem="{Binding SelectedState}"/>
                        <Button Content="{local:Loc dev.apply_state}"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding ForceStateCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Botón de minimizar -->
        <Button Content="&#xE921;"
                Style="{StaticResource MinimizeButton}"
                Click="OnMinimizeClick"
                ToolTip="{local:Loc common.minimize}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,46,0"
                WindowChrome.IsHitTestVisibleInChrome="True"/>

        <!-- Botón de cerrar -->
        <Button Content="&#xE8BB;"
                Style="{StaticResource TitleBarButton}"
                Click="OnCloseClick"
                ToolTip="{local:Loc common.close}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                WindowChrome.IsHitTestVisibleInChrome="True"/>
    </Grid>
</Window>
