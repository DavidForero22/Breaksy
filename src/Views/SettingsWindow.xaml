<Window x:Class="Breaksy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración - Breaksy"
        Height="300"
        Width="300"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#252526"
        Foreground="White">
    <Grid Margin="20">
        <StackPanel>
            <!-- Sección de Usuario -->
            <TextBlock Text="Opciones Generales"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"
                       Foreground="#4FC3F7"/>
            <CheckBox Content="Silenciar voces y sonidos"
                      IsChecked="{Binding IsMuted}"
                      Foreground="White"
                      FontSize="14"
                      Cursor="Hand"/>

            <Separator Margin="0,20,0,15"
                       Background="#444444"
                       Height="1"/>

            <!-- Sección de Desarrollador -->
            <TextBlock Text="Opciones de Desarrollador"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"
                       Foreground="#FFB300"/>

            <CheckBox Content="Mostrar consola de depuración"
                      IsChecked="{Binding IsDebugConsoleEnabled}"
                      Foreground="White"
                      FontSize="14"
                      Cursor="Hand"
                      Margin="0,0,0,15"/>

            <Button Content="Menú de Pruebas"
                    Command="{Binding OpenTestMenuCommand}"
                    Width="140"
                    Height="30"
                    HorizontalAlignment="Left"
                    Background="#333333"
                    Foreground="White"
                    BorderBrush="#555555"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>