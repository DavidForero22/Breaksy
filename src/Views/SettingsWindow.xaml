<Window x:Class="Breaksy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración - Breaksy"
        Width="720"
        Height="560"
        MinWidth="600"
        MinHeight="400"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">

    <!-- Barra de título propia: se puede arrastrar desde la franja superior y redimensionar por los bordes -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <TabControl Style="{StaticResource SidebarTabControl}">

            <!-- General -->
            <TabItem Header="General">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Información de la aplicación y actualizaciones."
                               Style="{StaticResource PageSubtitle}"/>

                    <TextBlock Text="VERSIÓN" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Style="{StaticResource OptionTitle}">
                        <Run Text="Breaksy"/>
                        <Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}"/>
                    </TextBlock>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <TextBlock Text="ACTUALIZACIONES" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding Updates.Status}"
                               Style="{StaticResource OptionDescription}"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Buscar actualizaciones"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CheckUpdatesCommand}"
                                IsEnabled="{Binding Updates.IsInstalled}"
                                Margin="0,0,8,0"/>
                        <Button Content="Actualizar y reiniciar"
                                Command="{Binding InstallUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Updates.IsUpdateAvailable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Updates.IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Aplicación -->
            <TabItem Header="Aplicación">
                <StackPanel>
                    <TextBlock Text="Aplicación" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Cómo te avisa e interrumpe Breaksy cuando se acaba el tiempo."
                               Style="{StaticResource PageSubtitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Silenciar voces" Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="Desactiva todas las líneas de voz del personaje."
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding IsMuted}"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mostrar estado" Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="Muestra el estado actual debajo del personaje."
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding ShowState}"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mostrar temporizador" Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="Muestra el tiempo restante debajo del personaje."
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding ShowTimer}"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <TextBlock Text="Nivel de interrupción" Style="{StaticResource OptionTitle}"/>
                    <ListBox Style="{StaticResource SegmentedControl}"
                             ItemsSource="{Binding InterruptionLevels}"
                             SelectedItem="{Binding SelectedInterruptionLevel}"
                             DisplayMemberPath="Name"
                             Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding SelectedInterruptionLevel.Description}"
                               Style="{StaticResource OptionDescription}"
                               Margin="0,8,0,0"/>

                    <!-- Aviso si Windows no permitió registrar el hook de teclado -->
                    <Border Background="#33F23F43"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,12,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardBlockUnavailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="⚠ El bloqueo de teclado no está disponible en este equipo. Los niveles Intermedio y Estricto funcionarán sin bloquear el teclado. Consulta la consola de depuración para ver el motivo."
                                   Style="{StaticResource OptionDescription}"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0"/>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Personalización -->
            <TabItem Header="Personalización">
                <StackPanel>
                    <TextBlock Text="Personalización" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Próximamente." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </TabItem>

            <!-- Desarrollador -->
            <TabItem Header="Desarrollador">
                <StackPanel>
                    <TextBlock Text="Desarrollador" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Herramientas de depuración y pruebas."
                               Style="{StaticResource PageSubtitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Consola de depuración" Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="Muestra el registro de eventos de la aplicación en una ventana aparte."
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding IsDebugConsoleEnabled}"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource OptionDivider}"/>

                    <!-- Menú de pruebas -->
                    <StackPanel DataContext="{Binding TestMenu}">
                        <TextBlock Text="DURACIONES" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Trabajo (min)" Style="{StaticResource OptionDescription}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBox}" HorizontalAlignment="Left"
                                         Text="{Binding AwakenMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Avisos (min)" Style="{StaticResource OptionDescription}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBox}" HorizontalAlignment="Left"
                                         Text="{Binding WarningMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Descanso (seg)" Style="{StaticResource OptionDescription}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBox}" HorizontalAlignment="Left"
                                         Text="{Binding SleepSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource OptionDivider}"/>

                        <TextBlock Text="FORZAR ESTADO" Style="{StaticResource SectionLabel}"/>
                        <ListBox Style="{StaticResource SegmentedControl}"
                                 ItemsSource="{Binding AvailableStates}"
                                 SelectedItem="{Binding SelectedState}"/>
                        <Button Content="Aplicar estado"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding ForceStateCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Botón de cerrar -->
        <Button Content="&#xE8BB;"
                Style="{StaticResource TitleBarButton}"
                Click="OnCloseClick"
                ToolTip="Cerrar"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                WindowChrome.IsHitTestVisibleInChrome="True"/>
    </Grid>
</Window>
