<Window x:Class="Breaksy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Breaksy.Views"
        Title="Breaksy"
        Height="180"
        Width="140"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">

        <Window.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </Window.Resources>

        <Grid Background="Transparent">

                <Grid.ContextMenu>
                        <local:CharacterContextMenu/>
                </Grid.ContextMenu>

                <!-- Contenedor de la Mascota -->
                <Border Margin="10,10,10,45"
                        CornerRadius="15"
                        Cursor="Hand"
                        MinWidth="100"
                                MinHeight="100">

                        <Border.Style>
                                <Style TargetType="Border">
                                        <Setter Property="Background"
                                                        Value="Transparent"/>
                                        <Style.Triggers>
                                                <!-- Si el servicio devuelve vacío, pinta un cuadrado blanco sólido  -->
                                                <DataTrigger Binding="{Binding ImagePath}"
                                                                Value="">
                                                        <Setter Property="Background"
                                                                        Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImagePath}"
                                                                Value="{x:Null}">
                                                        <Setter Property="Background"
                                                                        Value="White"/>
                                                </DataTrigger>
                                        </Style.Triggers>
                                </Style>
                        </Border.Style>

                        <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                                Command="{Binding StartCommand}"/>
                        </Border.InputBindings>

                        <Border.Effect>
                                <DropShadowEffect ShadowDepth="2"
                                                BlurRadius="5"
                                                Opacity="0.6"/>
                        </Border.Effect>

                        <!-- La imagen se pintará encima del borde -->
                        <Image Source="{Binding ImagePath}"
                                        Stretch="Uniform"/>
                </Border>

                <!-- Textos informativos  -->
                <StackPanel VerticalAlignment="Bottom"
                                Margin="0,0,0,5">
                        <TextBlock Text="{Binding StateText}"
                                   Visibility="{Binding ShowState, Converter={StaticResource BoolToVis}}"
                                   Foreground="#4FC3F7"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1"
                                                        BlurRadius="2"
                                                        Color="Black"/>
                                </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding TimeText}"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center">
                                <!-- Hidden (no Collapsed) para que el estado no cambie de sitio al ocultar el temporizador -->
                                <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowTimer}"
                                                                     Value="False">
                                                                <Setter Property="Visibility"
                                                                        Value="Hidden"/>
                                                        </DataTrigger>
                                                </Style.Triggers>
                                        </Style>
                                </TextBlock.Style>
                                <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1"
                                                        BlurRadius="2"
                                                        Color="Black"/>
                                </TextBlock.Effect>
                        </TextBlock>
                </StackPanel>
        </Grid>
</Window>