<Window x:Class="Breaksy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Breaksy"
        Height="380"
        Width="260"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#1E1E1E">
    <Grid Margin="12">
        <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <TextBlock Text="Breaksy"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <!-- Fase 2: estado y tiempo restante, solo para pruebas -->
            <TextBlock x:Name="TxTStatus"
                       Text="Estado: Idle"
                       Foreground="#4FC3F7"
                       FontSize="13"
                       FontWeight="Bold"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtTime"
                       Text="--:--"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,2,0,10"
                       HorizontalAlignment="Center"/>

            <!-- Fase 2: botones de prueba de la máquina de estados -->
            <Button x:Name="BtnStart"
                    Content="Iniciar"
                    Margin="0,2"
                    Click="OnBtnStartClick"/>
            <Button x:Name="BtnPause"
                    Content="Pausar"
                    Margin="0,2"
                    Click="OnBtnPauseClick"/>
            <Button x:Name="BtnExtend"
                    Content="+5 minutos"
                    Margin="0,2"
                    Click="OnBtnExtendClick"/>
            <Button x:Name="BtnRest"
                    Content="Descansar"
                    Margin="0,2"
                    Click="OnBtnRestClick"/>
            <Button x:Name="BtnDisable"
                    Content="Desactivar"
                    Margin="0,2"
                    Click="OnBtnDisableClick"/>

            <!-- único punto de cierre permitido mientras BlockNormalClosing = true -->
            <Button Content="Cerrar (prueba)"
                    Margin="0,10,0,0"
                    Click="OnBtnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>