<Window x:Class="Breaksy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Breaksy.Views"
        Title="Breaksy"
        Height="180"
                Width="140"
        WindowStyle="None"
                ResizeMode="NoResize"
                ShowInTaskbar="True"
        Topmost="True"
                AllowsTransparency="True"
                Background="Transparent">

        <Grid Background="Transparent">

                <Grid.ContextMenu>
                        <local:CharacterContextMenu/>
                </Grid.ContextMenu>

                <Border Background="{Binding FaceBackground}"
                        CornerRadius="15"
                                Margin="10,10,10,45"
                        BorderBrush="#222222"
                                BorderThickness="2">

                        <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                                Command="{Binding StartCommand}"/>
                        </Border.InputBindings>

                        <TextBlock Text="{Binding Face}"
                                        Cursor="Hand"
                                   FontSize="45"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Bottom"
                                Margin="0,0,0,5">
                        <TextBlock Text="{Binding StateText}"
                                        Foreground="#4FC3F7"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1"
                                                        BlurRadius="2"
                                                        Color="Black"/>
                                </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding TimeText}"
                                        Foreground="White"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1"
                                                        BlurRadius="2"
                                                        Color="Black"/>
                                </TextBlock.Effect>
                        </TextBlock>
                </StackPanel>
        </Grid>
</Window>