<Window x:Class="Breaksy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Breaksy"
        Height="140"
        Width="240"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#1E1E1E">
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <TextBlock Text="Breaksy"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Fase 0 — detección de teclado"
                       Foreground="#AAAAAA"
                       FontSize="11"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="(mira la consola)"
                       Foreground="#666666"
                       FontSize="10"
                       Margin="0,2,0,0"
                       HorizontalAlignment="Center"/>

            <!-- único punto de cierre permitido mientras BlockNormalClosing = true -->
            <Button Content="Cerrar (prueba)"
                    Margin="0,10,0,0"
                    Click="OnBtnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>