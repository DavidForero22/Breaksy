<Window x:Class="Breaksy.Views.BlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opciones"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="#2D2D30"
            CornerRadius="10"
            Margin="10"
            BorderBrush="#444444"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2"
                    BlurRadius="5"
                    Opacity="0.5"/>
        </Border.Effect>

        <StackPanel Margin="15">
            <Button Content="Descansar"
                    Command="{Binding RestCommand}"
                    Width="150"
                    Height="35"
                    Margin="0,0,0,10"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>

            <Button Content="+5 minutos"
                    Command="{Binding ExtendCommand}"
                    Visibility="{Binding CanExtend, Converter={StaticResource BoolToVis}}"
                    Width="150"
                    Height="35"
                    FontSize="14"
                    Background="#FF9800"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>