<ContextMenu x:Class="Breaksy.Views.CharacterContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <MenuItem Header="{Binding PauseMenuHeader}"
                        Command="{Binding PauseCommand}"
                        IsEnabled="{Binding CanPause}"/>
        <MenuItem Header="{Binding ActivationMenuHeader}"
                        Command="{Binding ToggleActivationCommand}"
                        IsEnabled="{Binding CanToggleActivation}"/>
        <Separator/>
        <MenuItem Header="Configuración"
                        Command="{Binding OpenSettingsCommand}"/>
        <Separator/>
        <MenuItem Header="Cerrar Breaksy"
                        Command="{Binding CloseCommand}"/>
</ContextMenu>