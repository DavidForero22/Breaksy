<UserControl x:Class="Breaksy.Views.CharacterEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Breaksy.Views">

    <UserControl.Resources>
        <!-- Botón pequeño Imagen / Sonido; se resalta el modo abierto -->
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Hueco de un archivo: vacío (clic o arrastrar) o con el nombre del archivo y una X -->
        <DataTemplate x:Key="SlotTemplate">
            <Border x:Name="Slot"
                    Width="88"
                    Height="88"
                    Margin="0,0,8,8"
                    CornerRadius="6"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    AllowDrop="True"
                    DragEnter="OnSlotDragEnter"
                    DragOver="OnSlotDragOver"
                    DragLeave="OnSlotDragLeave"
                    Drop="OnSlotDrop"
                    MouseLeftButtonUp="OnSlotClick">
                <Grid>
                    <TextBlock x:Name="Hint"
                               Text="{local:Loc editor.pick_or_drop}"
                               Foreground="{StaticResource SubtleTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="8,0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Cursor="Hand"/>
                    <Grid x:Name="Filled" Visibility="Collapsed">
                        <!-- Imagen: miniatura; sonido: nombre del archivo -->
                        <Image Source="{Binding Thumbnail}"
                               ToolTip="{Binding FileName}"
                               Stretch="Uniform"
                               Margin="6"/>
                        <TextBlock x:Name="FileNameText"
                                   Text="{Binding FileName}"
                                   ToolTip="{Binding FilePath}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="8,14,8,8"
                                   Visibility="Collapsed"/>
                        <Button Content="&#xE711;"
                                Command="{Binding RemoveCommand}"
                                ToolTip="{local:Loc editor.remove}"
                                Width="22"
                                Height="22"
                                Margin="0,2,2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="{StaticResource MutedTextBrush}"
                                Background="Transparent"
                                BorderThickness="0"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                    <Setter TargetName="Hint" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Filled" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsImage}" Value="False">
                    <Setter TargetName="FileNameText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger SourceName="Slot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Slot" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SlotList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource SlotTemplate}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Estados en horizontal; el elegido muestra debajo su editor -->
        <ListBox ItemsSource="{Binding States}"
                 SelectedItem="{Binding SelectedState}"
                 DisplayMemberPath="Name"
                 Style="{StaticResource SegmentedControl}"
                 Margin="0,12,0,0"/>

        <ContentControl Content="{Binding SelectedState}">
            <ContentControl.ContentTemplate>
            <DataTemplate>
                <StackPanel Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="ImageButton"
                                Content="{local:Loc editor.image}"
                                Style="{StaticResource ModeButton}"
                                Command="{Binding ToggleImageCommand}"/>
                        <Button x:Name="SoundButton"
                                Content="{local:Loc editor.sound}"
                                Style="{StaticResource ModeButton}"
                                Command="{Binding ToggleSoundCommand}"
                                IsEnabled="{Binding HasSounds}"/>
                    </StackPanel>

                    <!-- Imágenes -->
                    <StackPanel x:Name="ImagePanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource OptionDescription}" Margin="0,0,0,8">
                            <Run Text="{local:Loc editor.formats}"/><Run Text="{Binding Images.FormatsText, Mode=OneWay}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Images.Slots}"
                                      Style="{StaticResource SlotList}"/>
                    </StackPanel>

                    <!-- Sonidos: primero el evento y luego su lista -->
                    <StackPanel x:Name="SoundPanel" Visibility="Collapsed">
                        <ListBox ItemsSource="{Binding SoundEvents}"
                                 SelectedItem="{Binding SelectedSoundEvent}"
                                 DisplayMemberPath="Label"
                                 Style="{StaticResource SegmentedControl}"
                                 Margin="0,0,0,8"/>
                        <!-- Tipo (voz o sonido) y silencio propios de este evento -->
                        <WrapPanel DataContext="{Binding SelectedSoundEvent}" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="{local:Loc editor.type}"
                                           Style="{StaticResource OptionDescription}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <ListBox ItemsSource="{Binding AudioTypes}"
                                         SelectedItem="{Binding SelectedType}"
                                         DisplayMemberPath="Label"
                                         Style="{StaticResource SegmentedControl}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="{local:Loc editor.mute_tip}">
                                <TextBlock Text="{local:Loc editor.mute}"
                                           Style="{StaticResource OptionDescription}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding IsMuted}"
                                          IsEnabled="{Binding CanMute}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource OptionDescription}" Margin="0,0,0,8">
                            <Run Text="{local:Loc editor.formats}"/><Run Text="{Binding SelectedSoundEvent.Assets.FormatsText, Mode=OneWay}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding SelectedSoundEvent.Assets.Slots}"
                                      Style="{StaticResource SlotList}"/>
                    </StackPanel>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsImageMode}" Value="True">
                        <Setter TargetName="ImagePanel" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="ImageButton" Property="Background" Value="{StaticResource AccentBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSoundMode}" Value="True">
                        <Setter TargetName="SoundPanel" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="SoundButton" Property="Background" Value="{StaticResource AccentBrush}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Restablecer lo personalizado -->
        <Border Style="{StaticResource OptionDivider}"/>
        <TextBlock Text="{local:Loc editor.defaults}" Style="{StaticResource SectionLabel}"/>

        <TextBlock Text="{local:Loc editor.reset_images}" Style="{StaticResource OptionTitle}"/>
        <TextBlock Text="{local:Loc editor.reset_images_desc}" Style="{StaticResource OptionDescription}"/>
        <Button Content="{local:Loc editor.reset_images_btn}"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding ResetImagesCommand}"
                HorizontalAlignment="Left"
                Margin="0,10,0,16"/>

        <TextBlock Text="{local:Loc editor.reset_audio}" Style="{StaticResource OptionTitle}"/>
        <TextBlock Text="{local:Loc editor.reset_audio_desc}" Style="{StaticResource OptionDescription}"/>
        <Button Content="{local:Loc editor.reset_audio_btn}"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding ResetAudioCommand}"
                HorizontalAlignment="Left"
                Margin="0,10,0,16"/>

        <TextBlock Text="{local:Loc editor.reset_types}" Style="{StaticResource OptionTitle}"/>
        <TextBlock Text="{local:Loc editor.reset_types_desc}" Style="{StaticResource OptionDescription}"/>
        <Button Content="{local:Loc editor.reset_types_btn}"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding ResetAudioTypesCommand}"
                HorizontalAlignment="Left"
                Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
